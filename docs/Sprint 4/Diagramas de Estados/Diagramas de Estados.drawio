=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="95.0" y="332.0" width="270.0" height="76.0" as="geometry"/></mxCell><mxCell id="est2-exp" value="&lt;b&gt;Expirado&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;entry / estorna os Egos (se configurado)&lt;br&gt;e publica CupomNotificado(EXPIRADO)" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="435.0" y="339.0" width="270.0" height="62.0" as="geometry"/></mxCell><mxCell id="est2-con" value="&lt;b&gt;Confirmado&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;entry / publica CupomNotificado(USADO)&lt;br&gt;e executa aoConfirmarUso (cashback)" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="750.0" y="339.0" width="260.0" height="62.0" as="geometry"/></mxCell><mxCell id="est2-fc" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="218.0" y="458.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="est2-fe" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="558.0" y="458.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="est2-fo" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="868.0" y="458.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="est2-nota" value="Em Confirmado, Cancelado e Expirado&lt;br&gt;qualquer outra operação é recusada&lt;br&gt;(ApiException: transição inválida)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="270.0" y="505.0" width="250.0" height="50.0" as="geometry"/></mxCell><mxCell id="est2-3" value="resgatar(vantagem)&lt;br&gt;[saldo ≥ custo]" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-i" target="est2-sol"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-22"/></mxGeometry></mxCell><mxCell id="est2-4" value="gerarCupom / código único,&lt;br&gt;validade = agora + prazo&lt;br&gt;(ConfiguracaoSistema)" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-sol" target="est2-agu"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-32"/></mxGeometry></mxCell><mxCell id="est2-5" value="cancelar&lt;br&gt;[falha ao gerar o cupom]" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.2391;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-sol" target="est2-can"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/></mxGeometry></mxCell><mxCell id="est2-6" value="cancelar [pedido do aluno ou do admin]" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.0862;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8333;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-agu" target="est2-can"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-10"/><Array as="points"><mxPoint x="610.0" y="200.0"/><mxPoint x="320.0" y="200.0"/></Array></mxGeometry></mxCell><mxCell id="est2-7" value="after(prazo de validade),&lt;br&gt;confirmar(código) [agora &amp;gt; validade]" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.3276;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6481;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-agu" target="est2-exp"><mxGeometry x="0.1" relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/><Array as="points"><mxPoint x="680.0" y="262.0"/><mxPoint x="610.0" y="262.0"/></Array></mxGeometry></mxCell><mxCell id="est2-8" value="confirmar(código)&lt;br&gt;[empresa dona da vantagem&lt;br&gt;∧ agora ≤ validade]&lt;br&gt;/ registra dataUso" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.8793;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3462;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-agu" target="est2-con"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/></mxGeometry></mxCell><mxCell id="est2-9" value="" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-can" target="est2-fc"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/></mxGeometry></mxCell><mxCell id="est2-10" value="" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est2-exp" target="est2-fe"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/></mxGeo