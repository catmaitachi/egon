<mxfile host="app.diagrams.net" agent="egon/uml.py"><diagram id="est1" name="2.1 - ConfiguracaoSistema"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="est1-2" value="stm ConfiguracaoSistema" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=177;height=22;fontSize=11;fontStyle=1;fillColor=none;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="10.0" y="10.0" width="940.0" height="590.0" as="geometry"/></mxCell><mxCell id="est1-i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="130.0" y="60.0" width="20.0" height="20.0" as="geometry"/></mxCell><mxCell id="est1-carr" value="&lt;b&gt;Carregando&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;entry / lê ParametrosSistema&lt;br&gt;(cria a linha com os padrões&lt;br&gt;se ainda não existir)" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="35.0" y="120.0" width="210.0" height="76.0" as="geometry"/></mxCell><mxCell id="est1-c1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="122.0" y="232.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="est1-ff" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="128.0" y="333.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="est1-vig" value="&lt;b&gt;Vigente&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;do / atende consultas em memória&lt;br&gt;consultar(chave) / devolve o valor&lt;br&gt;atualizar [perfil ≠ ADMIN] / recusa (403)" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340.0" y="230.0" width="280.0" height="76.0" as="geometry"/></mxCell><mxCell id="est1-fim" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="468.0" y="110.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="est1-val" value="&lt;b&gt;Validando&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;entry / confere tipos e faixas" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340.0" y="400.0" width="280.0" height="48.0" as="geometry"/></mxCell><mxCell id="est1-grav" value="&lt;b&gt;Gravando&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;entry / grava ParametrosSistema&lt;br&gt;(leitores ainda veem os valores antigos)" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340.0" y="510.0" width="280.0" height="62.0" as="geometry"/></mxCell><mxCell id="est1-3" value="subida da aplicação&lt;br&gt;/ contêiner cria o bean" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est1-i" target="est1-carr"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" x="85" y="0"/></mxGeometry></mxCell><mxCell id="est1-4" value="" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="est1-carr" target="est1-c1"><mxGeometry x="0.0" relative="1" as="geometry">